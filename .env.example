# Mini-DSS — docker-compose sozlamalari.
# Nusxa oling:  cp .env.example .env

# --- Portlar (6xxx bloki) ---
# DIQQAT: 6000 ISHLATILMAYDI — Chrome uni bloklaydi (ERR_UNSAFE_PORT,
# X11 uchun ajratilgan). Boshqa bloklangan portlar: 6665-6669, 6697, 10080.
APP_PORT=6080        # Nuxt admin panel
API_PORT=6081        # Go API
FACE_API_PORT=6001   # foto validatsiya
DB_PORT_HOST=6432

# --- Mini-DSS o'z bazasi ---
# ⚠️ Ikki rol: ilova NOSUPERUSER minidss_app bilan ulanadi (RCE'ga qarshi),
#    superuser minidss faqat migratsiya uchun. Batafsil: TASK-02.
# Kuchli parol: openssl rand -base64 24
DB_DATABASE=minidss
DB_USERNAME=minidss_app
DB_PASSWORD=CHANGE_ME_strong_app_password
# Superuser (postgres bootstrap + qo'lda migratsiya). Ilova buni ISHLATMAYDI.
DB_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# --- Xavfsizlik ---
# ⛔ ENCRYPTION_KEY o'zgarsa qurilma parollari o'qilmay qoladi va qayta
#    kiritilishi kerak bo'ladi. Yangi kalit: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME
JWT_SECRET=CHANGE_ME
JWT_TTL_MINUTES=720

ADMIN_USER=admin
ADMIN_PASSWORD=admin123

MINIDSS_TIMEZONE=Asia/Tashkent

# Terminallar uchun NTP serveri — SHU serverning IP'si.
#
# ⚠️ NOM emas, IP yozing: ichki DNS tashqi nomlarni o'ziga qaytaradi
#    (pool.ntp.org -> 172.16.0.254) va u NTP tarqatmaydi.
# ⚠️ Tashqi NTP ham ishlamaydi: terminallar tarmog'idan (192.168.30.x)
#    UDP/123 chiqmaydi. Shuning uchun compose'da `ntp` xizmati turadi va
#    qurilmalar shu serverga yo'naltiriladi — bu yerga host IP'sini yozing.
MINIDSS_NTP_ADDR=172.16.240.70

# ESLATMA: terminal IP/parollari BU YERDA EMAS — UI orqali kiritiladi va
# devices jadvalida shifrlangan holda saqlanadi.

# --- HEMIS API (sync manbasi) ---
HEMIS_BASE_URL=https://student.ttyesi.uz
HEMIS_TOKEN=

# Rasm manbasi uchun ishonchli hostlar (vergul bilan).
#
# ⚠️ Rasmlar BOSHQA hostda turadi: hemis.ttyesi.uz — HEMIS_BASE_URL emas.
#    Va u ICHKI IP'da (172.16.0.253). SSRF himoyasi xususiy IP'larni
#    bloklaydi, shuning uchun bu host aniq yozilmasa HAMMA rasm
#    "manba URL ochilmadi" bilan rad etiladi (bir marta 7642 tasi shunday
#    ketgan). Ro'yxatdagilardan boshqa hamma URL baribir bloklanadi.
PHOTO_ALLOWED_HOSTS=hemis.ttyesi.uz

# Terminallardan hodisalarni JONLI olish (DSS uslubida).
#
# ⚠️ Oqim ochiq turganda terminal port 80'ga YANGI ulanish qabul qilmaydi —
#    veb-interfeysi ham ochilmaydi va qurilma "o'chib qolgan"day ko'rinadi.
#    Qurilmani sozlash kerak bo'lsa, avval buni false qiling.
# false qilinsa, jurnal har daqiqada yig'iladi.
MINIDSS_LIVE_EVENTS=true
